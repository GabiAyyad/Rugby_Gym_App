# Postgres connection string. Any Postgres works: local, Railway, Render, RDS, etc.
# postgres://user:password@host:5432/database
# Add ?sslmode=require if your host needs it (most hosted providers do).
DATABASE_URL=

# Signs the login session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Optional. Defaults to Asia/Nicosia (EET/EEST — correct for both Palestine and Cyprus squads).
NEXT_PUBLIC_APP_TIME_ZONE=
